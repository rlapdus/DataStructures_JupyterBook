xecutable":true,"value":"from DataStructureCode.BinarySearchTree import *\ntree = BinarySearchTree()\ntree.insert(8); tree.insert(3); tree.insert(10);\ntree.insert(1); tree.insert(6); tree.insert(14);\ntree.insert(4); tree.insert(7); tree.insert(13)\nResultNode = tree.search(6)\nprint(\"data in the resulting node is:\", ResultNode.data)","identifier":"0u4jqshmkjpj-code","enumerator":"3","html_id":"id-0u4jqshmkjpj-code","key":"RwInZpZSlP"},{"type":"outputs","id":"qXvW6SY7daRtO2jSIi4_p","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"data in the resulting node is: 6\n"},"children":[],"identifier":"0u4jqshmkjpj-outputs-0","html_id":"id-0u4jqshmkjpj-outputs-0","key":"c5dJihoMG9"}],"identifier":"0u4jqshmkjpj-outputs","html_id":"id-0u4jqshmkjpj-outputs","key":"KSU9OHRRP2"}],"identifier":"0u4jqshmkjpj","label":"0U4jqshMKJpJ","html_id":"id-0u4jqshmkjpj","key":"GqGTfqjN1M"},{"type":"block","kind":"notebook-content","data":{"id":"kUBEy0w8tseh"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example Tree","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q0dbwLZvyt"}],"identifier":"example-tree","label":"Example Tree","html_id":"example-tree","implicit":true,"key":"mRS9V7e6E0"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Draw this tree","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"MHA3DwuyXh"}],"key":"lkeGW8UjTn"}],"identifier":"kubey0w8tseh","label":"kUBEy0w8tseh","html_id":"kubey0w8tseh","key":"j0vNEr1AMG"},{"type":"block","kind":"notebook-code","data":{"executionInfo":{"elapsed":3,"status":"ok","timestamp":1779894207761,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"7IRLXrc-tsXm"},"children":[{"type":"code","lang":"python","executable":t