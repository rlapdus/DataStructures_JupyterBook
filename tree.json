e":"code","lang":"python","executable":true,"value":"from DataStructureCode.BinarySearchTree import *\ntree = BinarySearchTree()\ntree.insert(8); tree.insert(3); tree.insert(10);\ntree.insert(1); tree.insert(6); tree.insert(14);\ntree.insert(4); tree.insert(7); tree.insert(13)\nResultNode = tree.search(6)\nprint(\"data in the resulting node is:\", ResultNode.data)","identifier":"0u4jqshmkjpj-code","enumerator":"3","html_id":"id-0u4jqshmkjpj-code","key":"KGf4w76rGb"},{"type":"outputs","id":"j2ya1zr_OtlP7-rjYIE07","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"data in the resulting node is: 6\n"},"children":[],"identifier":"0u4jqshmkjpj-outputs-0","html_id":"id-0u4jqshmkjpj-outputs-0","key":"qDigwrau40"}],"identifier":"0u4jqshmkjpj-outputs","html_id":"id-0u4jqshmkjpj-outputs","key":"OUPOAdA00W"}],"identifier":"0u4jqshmkjpj","label":"0U4jqshMKJpJ","html_id":"id-0u4jqshmkjpj","key":"bUHs4881NN"},{"type":"block","kind":"notebook-content","data":{"id":"kUBEy0w8tseh"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example Tree","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pgla7JLArq"}],"identifier":"example-tree","label":"Example Tree","html_id":"example-tree","implicit":true,"key":"vynRZw4Coa"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Draw this tree","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"q7ZuwvTiGQ"}],"key":"RvqYsDxwVX"}],"identifier":"kubey0w8tseh","label":"kUBEy0w8tseh","html_id":"kubey0w8tseh","key":"bwKJr6cZNN"},{"type":"block","kind":"notebook-code","data":{"executionInfo":{"elapsed":3,"status":"ok","timestamp":1779894207761,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"7IRLXrc-tsXm"},"children":[{"type":"code","lang":"python","executable":true,"value":"# A Node in Binary Tree\nclass Node:\n  def __init__(self, data):\n    self.left = None\n    self.right = None\n    self.data = data\n\ntree = Node(1)\ntree.left = Node(2)\ntree.right = Node(3)\ntree.left.left = Node(4)\ntree.left.left.left = Node(5)\ntree.right.left = Node(6)\ntree.right.right = Node(7)\ntree.right.right.left = Node(8)\ntree.right.right.right = Node(9)","identifier":"7irlxrc-tsxm-code","enumerator":"4","html_id":"id-7irlxrc-tsxm-code","key":"n5ZDLFPtDV"},{"type":"outputs","id":"oFP4sq8w78KO4jt0_vKXv","children":[],"identifier":"7irlxrc-tsxm-outputs","html_id":"id-7irlxrc-tsxm-outputs","key":"r7v5dWqN9p"}],"identifier":"7irlxrc-tsxm","label":"7IRLXrc-tsXm","html_id":"id-7irlxrc-tsxm","key":"KybSdZMmAL"},{"type":"block","kind":"notebook-content","data":{"id":"MUKigVbUn1bf"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Inorder Traversal","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lx8PnNgdtC"}],"identifier":"inorder-traversal","label":"Inorder Traversal","html_id":"inorder-traversal","implicit":true,"key":"F2rSbfwCTh"}],"identifier":"mukigvbun1bf","label":"MUKigVbUn1bf","html_id":"mukigvbun1bf","key":"tiGR3Jvx7M"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":62,"status":"ok","timestamp":1779894209112,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"eVyRgct6n1Og","outputId":"0aae237b-22f5-4d78-f451-514b52155324"},"children":[{"type":"code","lang":"python","executable":true,"value":"def InOrder(node):\n  if node is None: return None\n  InOrder(node.left) # explore left subtree\n  print(node.data, end=' ') # print element in the node\n  InOrder(node.right) # explore right subtree\n\nprint(\"Inorder traversal of the binary tree is:\")\nInOrder(tree)","identifier":"evyrgct6n1og-code","enumerator":"5","html_id":"evyrgct6n1og-code","key":"kKdqd3DYnK"},{"type":"outputs","id":"vLk0csOriYE89l1x42AAg","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Inorder traversal of the binary tree is:\n5 4 2 1 6 3 8 7 9 "},"children":[],"identifier":"evyrgct6n1og-outputs-0","html_id":"evyrgct6n1og-outputs-0","key":"r0I5701GzA"}],"identifier":"evyrgct6n1og-outputs","html_id":"evyrgct6n1og-outputs","key":"jVtDDAbwTx"}],"identifier":"evyrgct6n1og","label":"eVyRgct6n1Og","html_id":"evyrgct6n1og","key":"kEV20FAgjL"},{"type":"block","kind":"notebook-content","data":{"id":"uB3lvSEloZEM"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Exercises!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"c2HlbJEBfW"}],"identifier":"exercises","label":"Exercises!","html_id":"exercises","implicit":true,"key":"p3CvqvatY9"}],"identifier":"ub3lvselozem","label":"uB3lvSEloZEM","html_id":"ub3lvselozem","key":"K6z2WqzY0y"},{"type":"block","kind":"notebook-content","data":{"id":"Zu2Sv5NcoSIA"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pre/Postorder Traversal","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BTnpBM85ZF"}],"identifier":"pre-postorder-traversal","label":"Pre/Postorder Traversal","html_id":"pre-postorder-traversal","implicit":true,"key":"uCXP71DiQ2"}],"identifier":"zu2sv5ncosia","label":"Zu2Sv5NcoSIA","html_id":"zu2sv5ncosia","key":"CX1R0uSnNM"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":44,"status":"ok","timestamp":1779894210399,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"Qd2aGZZYn1Iv","outputId":"8b5d51f3-d955-4a98-90f7-f2e07620a5af"},"children":[{"type":"code","lang":"python","executable":true,"value":"# Preorder: node → left → right\ndef PreOrder(node):\n    if node is None:\n        return None\n\n    print(node.data, end=' ')\n    PreOrder(node.left)\n    PreOrder(node.right)\n\n\n\n\n# Postorder: left → right → node\ndef PostOrder(node):\n    if node is None:\n        return None\n\n    PostOrder(node.left)\n    PostOrder(node.right)\n    print(node.data, end=' ')\n\n\n# Create tree\ntree = Node(1)\ntree.left = Node(2)\ntree.right = Node(3)\ntree.left.left = Node(4)\ntree.left.left.left = Node(5)\ntree.right.left = Node(6)\ntree.right.right = Node(7)\ntree.right.right.left = Node(8)\ntree.right.right.right = Node(9)\n\n# Example\nprint(\"Preorder traversal of the binary tree is:\")\n#\nPreOrder(tree)\nprint()\n\nprint(\"Postorder traversal of the binary tree is:\")\n#\nPostOrder(tree)\nprint()\n","identifier":"qd2agzzyn1iv-code","enumerator":"6","html_id":"qd2agzzyn1iv-code","key":"GRCcq0MCvw"},{"type":"outputs","id":"frVzBGfB0ZvOFTGFtkvsj","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Preorder traversal of the binary tree is:\n1 2 4 5 3 6 7 8 9 \nPostorder traversal of the binary tree is:\n5 4 2 6 8 9 7 3 1 \n"},"children":[],"identifier":"qd2agzzyn1iv-outputs-0","html_id":"qd2agzzyn1iv-outputs-0","key":"dWnbU2YWpb"}],"identifier":"qd2agzzyn1iv-outputs","html_id":"qd2agzzyn1iv-outputs","key":"mdM0VhIvBx"}],"identifier":"qd2agzzyn1iv","label":"Qd2aGZZYn1Iv","html_id":"qd2agzzyn1iv","key":"L4Imhfrr3D"},{"type":"block","kind":"notebook-content","data":{"id":"e7UxzOMlp1hX"},"children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Traversing Binary Search Tree","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oFsfzwtD3s"}],"identifier":"traversing-binary-search-tree","label":"Traversing Binary Search Tree","html_id":"traversing-binary-search-tree","implicit":true,"key":"QrVa1nFEDq"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Show the result of each traversal of the below binary search tree.Which traversal allows you to obtain sorted values in ascending order among inorder, postorder, preorder, and level order?","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hdyyn8q0Cy"}],"key":"HqoqPtluGx"}],"identifier":"e7uxzomlp1hx","label":"e7UxzOMlp1hX","html_id":"e7uxzomlp1hx","key":"WxDEP8qkNz"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":6,"status":"ok","timestamp":1779894212604,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"iVwVDKuNp1Ye","outputId":"bcc157df-590e-4aa0-e01e-c0f80e6c6ff6"},"children":[{"type":"code","lang":"python","executable":true,"value":"tree = BinarySearchTree()\ntree.insert(100)\ntree.insert(20)\ntree.insert(500)\ntree.insert(10)\ntree.insert(30)\ntree.insert(40)\n\nprint(\"Inorder traversal of the binary tree is:\")\nInOrder(tree.root)\nprint()\n\nprint(\"Preorder traversal of the binary tree is:\")\nPreOrder(tree.root)\nprint()\n\nprint(\"Postorder traversal of the binary tree is:\")\nPostOrder(tree.root)\nprint()","identifier":"ivwvdkunp1ye-code","enumerator":"7","html_id":"ivwvdkunp1ye-code","key":"tqzURY9e2S"},{"type":"outputs","id":"Pgq1yBax5Vu-ApVWBa8Oc","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Inorder traversal of the binary tree is:\n10 20 30 40 100 500 \nPreorder traversal of the binary tree is:\n100 20 10 30 40 500 \nPostorder traversal of the binary tree is:\n10 40 30 20 500 100 \n"},"children":[],"identifier":"ivwvdkunp1ye-outputs-0","html_id":"ivwvdkunp1ye-outputs-0","key":"KbPIOBPHjd"}],"identifier":"ivwvdkunp1ye-outputs","html_id":"ivwvdkunp1ye-outputs","key":"pvOvs0HVKb"}],"identifier":"ivwvdkunp1ye","label":"iVwVDKuNp1Ye","html_id":"ivwvdkunp1ye","key":"wS2BLHXFEZ"},{"type":"block","kind":"notebook-content","data":{"id":"1IawqcXfqrbP"},"children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Add a print method in BinarySearchTree module","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UT1mlZGVxe"}],"identifier":"add-a-print-method-in-binarysearchtree-module","label":"Add a print method in BinarySearchTree module","html_id":"add-a-print-method-in-binarysearchtree-module","implicit":true,"key":"LNVE5VLKyS"}],"identifier":"1iawqcxfqrbp","label":"1IawqcXfqrbP","html_id":"id-1iawqcxfqrbp","key":"hgZ12CExQx"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"executionInfo":{"elapsed":26,"status":"ok","timestamp":1779894214300,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"j2VWTF7pqqvZ","outputId":"7f40174a-d0ec-4bbd-ac3b-8896505b694b"},"children":[{"type":"code","lang":"python","executable":true,"value":"class BinarySearchTree:\n  def __init__(self):\n    self.root = None\n\n\t# Search\n  def search(self, x) -> TreeNode:\n    return self.searchItem(self.root, x)\n\n  def searchItem(self, tNode:TreeNode, x) -> TreeNode:\n    if (tNode == None):\n      return None\n    elif (x == tNode.data):\n      return tNode\n    elif (x < tNode.data):\n      return self.searchItem(tNode.left, x)\n    else:\n      return self.searchItem(tNode.right, x)\n\n\t# Insertion\n  def insert(self, newItem):\n    self.root = self.insertItem(self.root, newItem)\n\n  def insertItem(self, tNode:TreeNode, newItem) -> TreeNode:\n    if (tNode == None):\n      tNode = TreeNode(newItem, None, None)\n    elif (newItem < tNode.data):  # branch left\n      tNode.left = self.insertItem(tNode.left, newItem)\n    else: # branch right\n      tNode.right = self.insertItem(tNode.right, newItem)\n    return tNode\n\n\t# Deletion\n  def delete(self, x):\n    self.root = self.deleteItem(self.root, x)\n\n  def deleteItem(self, tNode:TreeNode, x) -> TreeNode:\n    if (tNode == None): # return none if item not found\n      return None\n    elif (x == tNode.data):\t# if x is found, delete that node\n      tNode = self.deleteNode(tNode)\n    elif (x < tNode.data): # if x smaller, move to left child\n      tNode.left = self.deleteItem(tNode.left, x)\n    else: # if x bigger, move to right child\n      tNode.right = self.deleteItem(tNode.right, x)\n    return tNode # tNode: resulting node\n\n  def deleteNode(self, tNode:TreeNode) -> TreeNode:\n\t\t#     1. tNode is leaf node\n\t\t#     2. tNode has only one children\n\t\t#     3. tNode has two children\n    if tNode.left == None and tNode.right == None: # case 1 (leaf node)\n      return None\n    elif tNode.left == None:  # case 2 (only right child)\n      return tNode.right\n    elif tNode.right == None: # case 2 (onlt left child)\n      return tNode.left\n    else: # case 3 (two children)\n      (rtnItem, rtnNode) = self.deleteMinItem(tNode.right)\n      tNode.data = rtnItem\n      tNode.right = rtnNode\n      return tNode  # tNode survived\n\n  def deleteMinItem(self, tNode:TreeNode) -> tuple:\n    if tNode.left == None:\n      # found min at tNode\n      return (tNode.data, tNode.right)\n    else: # branch left\n      (rtnItem, rtnNode) = self.deleteMinItem(tNode.left)\n      tNode.left = rtnNode\n      return (rtnItem, tNode)\n\n  def isEmpty(self) -> bool:\n    return self.root == self.NIL\n\n  def clear(self):\n    self.root = self.NIL\n\n  def printBST(self):\n    InOrder(self.root)\n    print()\n\n\ntree = BinarySearchTree()\ntree.insert(8); tree.insert(3); tree.insert(10);\ntree.insert(1); tree.insert(6); tree.insert(14);\ntree.insert(4); tree.insert(7); tree.insert(13)\n\ntree.printBST()","identifier":"j2vwtf7pqqvz-code","enumerator":"8","html_id":"j2vwtf7pqqvz-code","key":"sFu5KX32CL"},{"type":"outputs","id":"LBEcnDdOusvHiOvnmGdk9","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1 3 4 6 7 8 10 13 14 \n"},"children":[],"identifier":"j2vwtf7pqqvz-outputs-0","html_id":"j2vwtf7pqqvz-outputs-0","key":"pJr9SyT2qw"}],"identifier":"j2vwtf7pqqvz-outputs","html_id":"j2vwtf7pqqvz-outputs","key":"wgOrchWWW0"}],"identifier":"j2vwtf7pqqvz","label":"j2VWTF7pqqvZ","html_id":"j2vwtf7pqqvz","key":"IdIKC2zFpv"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":8,"status":"ok","timestamp":1779894217575,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"TcelYB4PPoQK","outputId":"c77ef66f-372a-4a36-b1c3-5862e783dba4"},"children":[{"type":"code","lang":"python","executable":true,"value":"import importlib\nimport DataStructureCode.BinarySearchTree as BST\n\nimportlib.reload(BST)\n\nbst = BST.BinarySearchTree()\n\nbst.insert(30)\nbst.insert(20)\nbst.insert(40)\nbst.insert(10)\nbst.insert(25)\n\nbst.print()","identifier":"tcelyb4ppoqk-code","enumerator":"9","html_id":"tcelyb4ppoqk-code","key":"NtghTUNP9Y"},{"type":"outputs","id":"uO63KG8-OgLvdGyVzemwA","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"10 20 25 30 40 \n"},"children":[],"identifier":"tcelyb4ppoqk-outputs-0","html_id":"tcelyb4ppoqk-outputs-0","key":"kIGKL7ynVb"}],"identifier":"tcelyb4ppoqk-outputs","html_id":"tcelyb4ppoqk-outputs","key":"mDw9U7PBDJ"}],"identifier":"tcelyb4ppoqk","label":"TcelYB4PPoQK","html_id":"tcelyb4ppoqk","key":"lEDVZ5tTd3"}],"key":"if7uUUWLGq"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Stack & Queue","url":"/stack-queue","group":"Part 2. Linear Structures"},"next":{"title":"Linked Hash Map: Concept","short_title":"Linked Hash Map: Concept","url":"/final-project-lecture","group":"Part 4