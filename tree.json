,"enumerator":"5","html_id":"evyrgct6n1og-code","key":"iwAo4MOdCb"},{"type":"outputs","id":"AH7Qt_q7DHG1YJHd5ZDNr","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Inorder traversal of the binary tree is:\n5 4 2 1 6 3 8 7 9 "},"children":[],"identifier":"evyrgct6n1og-outputs-0","html_id":"evyrgct6n1og-outputs-0","key":"cLc6ZzzErL"}],"identifier":"evyrgct6n1og-outputs","html_id":"evyrgct6n1og-outputs","key":"Bck9yWQNgE"}],"identifier":"evyrgct6n1og","label":"eVyRgct6n1Og","html_id":"evyrgct6n1og","key":"ltitwEaps2"},{"type":"block","kind":"notebook-content","data":{"id":"uB3lvSEloZEM"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Exercises!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"o5NQ162eMd"}],"identifier":"exercises","label":"Exercises!","html_id":"exercises","implicit":true,"key":"iPb53xC22G"}],"identifier":"ub3lvselozem","label":"uB3lvSEloZEM","html_id":"ub3lvselozem","key":"aMesZvAREE"},{"type":"block","kind":"notebook-content","data":{"id":"Zu2Sv5NcoSIA"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pre/Postorder Traversal","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sb1EIqrnEO"}],"identifier":"pre-postorder-traversal","label":"Pre/Postorder Traversal","html_id":"pre-postorder-traversal","implicit":true,"key":"Vds4w5AP9D"}],"identifier":"zu2sv5ncosia","label":"Zu2Sv5NcoSIA","html_id":"zu2sv5ncosia","key":"pVwpSYHDv6"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":44,"status":"ok","timestamp":1779894210399,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"Qd2aGZZYn1Iv","outputId":"8b5d51f3-d955-4a98-90f7-f2e07620a5af"},"children":[{"type":"code","lang":"python","executable":true,"value":"# Preorder: node → left → right\ndef PreOrder(node):\n    if node is None:\n        return None\n\n    print(node.data, end=' ')\n    PreOrder(node.left)\n    PreOrder(node.right)\n\n\n\n\n# Postorder: left → right → node\ndef PostOrder(node):\n    if node is None:\n        return None\n\n    PostOrder(node.left)\n    PostOrder(node.right)\n    print(node.data, end=' ')\n\n\n# Create tree\ntree = Node(1)\ntree.left = Node(2)\ntree.right = Node(3)\ntree.left.left = Node(4)\ntree.left.left.left = Node(5)\ntree.right.left = Node(6)\ntree.right.right = Node(7)\ntree.right.right.left = Node(8)\ntree.right.right.right = Node(9)\n\n# Example\nprint(\"Preorder traversal of the binary tree is:\")\n#\nPreOrder(tree)\nprint()\n\nprint(\"Postorder traversal of the binary tree is:\")\n#\nPostOrder(tree)\nprint()\n","identifier":"qd2agzzyn1iv-code","enumerator":"6","html_id":"qd2agzzyn1iv-code","key":"i0Ihn3Gr3d"},{"type":"outputs","id":"j2YRuunL6Gu5eR8wTO5rT","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Preorder traversal of the binary tree is:\n1 2 4 5 3 6 7 8 9 \nPostorder traversal of the binary tree is:\n5 4 2 6 8 9 7 3 1 \n"},"children":[],"identifier":"qd2agzzyn1iv-outputs-0","html_id":"qd2agzzyn1iv-outputs-0","key":"I6SoaVzDEG"}],"identifier":"qd2agzzyn1iv-outputs","html_id":"qd2agzzyn1iv-outputs","key":"xWIPvrN8Sg"}],"identifier":"qd2agzzyn1iv","label":"Qd2aGZZYn1Iv","html_id":"qd2agzzyn1iv","key":"cLPIBcYU3a"},{"type":"block","kind":"notebook-content","data":{"id":"e7UxzOMlp1hX"},"children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Traversing Binary Search Tree","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Yc2QQ5LKlk"}],"identifier":"traversing-binary-search-tree","label":"Traversing Binary Search Tree","html_id":"traversing-binary-search-tree","implicit":true,"key":"jEt00wJOj5"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Show the result of each traversal of the below binary search tree.Which traversal allows you to obtain sorted values in ascending order among inorder, postorder, preorder, and level order?","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"I4qQYvjD7a"}],"key":"C3K0X7Xoe0"}],"identifier":"e7uxzomlp1hx","label":"e7UxzOMlp1hX","html_id":"e7uxzomlp1hx","key":"sCeZglhR05"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":6,"status":"ok","timestamp":1779894212604,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"iVwVDKuNp1Ye","outputId":"bcc157df-590e-4aa0-e01e-c0f80e6c6ff6"},"children":[{"type":"code","lang":"python","executable":true,"value":"tree = BinarySearchTree()\ntree.insert(100)\ntree.insert(20)\ntree.insert(500)\ntree.insert(10)\ntree.insert(30)\ntree.insert(40)\n\nprint(\"Inorder traversal of the binary tree is:\")\nInOrder(tree.root)\nprint()\n\nprint(\"Preorder traversal of the binary tree is:\")\nPreOrder(tree.root)\nprint()\n\nprint(\"Postorder traversal of the binary tree is:\")\nPostOrder(tree.root)\nprint()","identifier":"ivwvdkunp1ye-code","enumerator":"7","html_id":"ivwvdkunp1ye-code","key":"fjleHNt8K6"},{"type":"outputs","id":"oCYZaRCfAzXQSd5dRSLs5","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Inorder traversal of the binary tree is:\n10 20 30 40 100 500 \nPreorder traversal of the binary tree is:\n100 20 10 30 40 500 \nPostorder traversal of the binary tree is:\n10 40 30 20 500 100 \n"},"children":[],"identifier":"ivwvdkunp1ye-outputs-0","html_id":"ivwvdkunp1ye-outputs-0","key":"NNoz9KAE7H"}],"identifier":"ivwvdkunp1ye-outputs","html_id":"ivwvdkunp1ye-outputs","key":"RC6QerAIgz"}],"identifier":"ivwvdkunp1ye","label":"iVwVDKuNp1Ye","html_id":"ivwvdkunp1ye","key":"kr5rOurLxk"},{"type":"block","kind":"notebook-content","data":{"id":"1IawqcXfqrbP"},"children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Add a print method in BinarySearchTree module","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qmfOPigCRj"}],"identifier":"add-a-print-method-in-binarysearchtree-module","label":"Add a print method in BinarySearchTree module","html_id":"add-a-print-method-in-binarysearchtree-module","implicit":true,"key":"IQ162oETwI"}],"identifier":"1iawqcxfqrbp","label":"1IawqcXfqrbP","html_id":"id-1iawqcxfqrbp","key":"nANYI40USM"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"executionInfo":{"elapsed":26,"status":"ok","timestamp":1779894214300,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"j2VWTF7pqqvZ","outputId":"7f40174a-d0ec-4bbd-ac3b-8896505b694b"},"children":[{"type":"code","lang":"python","executable":true,"value":"class BinarySearchTree:\n  def __init__(self):\n    self.root = None\n\n\t# Search\n  def search(self, x) -> TreeNode:\n    return self.searchItem(self.root, x)\n\n  def searchItem(self, tNode:TreeNode, x) -> TreeNode:\n    if (tNode == None):\n      return None\n    elif (x == tNode.data):\n      return tNode\n    elif (x < tNode.data):\n      return self.searchItem(tNode.left, x)\n    else:\n      return self.searchItem(tNode.right, x)\n\n\t# Insertion\n  def insert(self, newItem):\n    self.root = self.insertItem(self.root, newItem)\n\n  def insertItem(self, tNode:TreeNode, newItem) -> TreeNode:\n    if (tNode == None):\n      tNode = TreeNode(newItem, None, None)\n    elif (newItem < tNode.data):  # branch left\n      tNode.left = self.insertItem(tNode.left, newItem)\n    else: # branch right\n      tNode.right = self.insertItem(tNode.right, newItem)\n    return tNode\n\n\t# Deletion\n  def delete(self, x):\n    self.root = self.deleteItem(self.root, x)\n\n  def deleteItem(self, tNode:TreeNode, x) -> TreeNode:\n    if (tNode == None): # return none if item not found\n      return None\n    elif (x == tNode.data):\t# if x is found, delete that node\n      tNode = self.deleteNode(tNode)\n    elif (x < tNode.data): # if x smaller, move to left child\n      tNode.left = self.deleteItem(tNode.left, x)\n    else: # if x bigger, move to right child\n      tNode.right = self.deleteItem(tNode.right, x)\n    return tNode # tNode: resulting node\n\n  def deleteNode(self, tNode:TreeNode) -> TreeNode:\n\t\t#     1. tNode is leaf node\n\t\t#     2. tNode has only one children\n\t\t#     3. tNode has two children\n    if tNode.left == None and tNode.right == None: # case 1 (leaf node)\n      return None\n    elif tNode.left == None:  # case 2 (only right child)\n      return tNode.right\n    elif tNode.right == None: # case 2 (onlt left child)\n      return tNode.left\n    else: # case 3 (two children)\n      (rtnItem, rtnNode) = self.deleteMinItem(tNode.right)\n      tNode.data = rtnItem\n      tNode.right = rtnNode\n      return tNode  # tNode survived\n\n  def deleteMinItem(self, tNode:TreeNode) -> tuple:\n    if tNode.left == None:\n      # found min at tNode\n      return (tNode.data, tNode.right)\n    else: # branch left\n      (rtnItem, rtnNode) = self.deleteMinItem(tNode.left)\n      tNode.left = rtnNode\n      return (rtnItem, tNode)\n\n  def isEmpty(self) -> bool:\n    return self.root == self.NIL\n\n  def clear(self):\n    self.root = self.NIL\n\n  def printBST(self):\n    InOrder(self.root)\n    print()\n\n\ntree = BinarySearchTree()\ntree.insert(8); tree.insert(3); tree.insert(10);\ntree.insert(1); tree.insert(6); tree.insert(14);\ntree.insert(4); tree.insert(7); tree.insert(13)\n\ntree.printBST()","identifier":"j2vwtf7pqqvz-code","enumerator":"8","html_id":"j2vwtf7pqqvz-code","key":"lx6l5FhMyP"},{"type":"outputs","id":"v6rCrkBklnAsg54c-GHrv","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1 3 4 6 7 8 10 13 14 \n"},"children":[],"identifier":"j2vwtf7pqqvz-outputs-0","html_id":"j2vwtf7pqqvz-outputs-0","key":"bjYd2nrwLd"}],"identifier":"j2vwtf7pqqvz-outputs","html_id":"j2vwtf7pqqvz-outputs","key":"fCKDZz7svt"}],"identifier":"j2vwtf7pqqvz","label":"j2VWTF7pqqvZ","html_id":"j2vwtf7pqqvz","key":"vZ26ZmtpZX"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":8,"status":"ok","timestamp":1779894217575,"user":{"displayName":"‎김예현(인공지능대학 데이터사이언스학과)","userId":"10385103229598348411"},"user_tz":-540},"id":"TcelYB4PPoQK","outputId":"c77ef66f-372a-4a36-b1c3-5862e783dba4"},"children":[{"type":"code","lang":"python","executable":true,"value":"import importlib\nimport DataStructureCode.BinarySearchTree as BST\n\nimportlib.reload(BST)\n\nbst = BST.BinarySearchTree()\n\nbst.insert(30)\nbst.insert(20)\nbst.insert(40)\nbst.insert(10)\nbst.insert(25)\n\nbst.print()","identifier":"tcelyb4ppoqk-code","enumerator":"9","html_id":"tcelyb4ppoqk-code","key":"L58GbiZ7al"},{"type":"outputs","id":"Rh2vZXkf1-bP9WGijKgTm","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"10 20 25 30 40 \n"},"children":[],"identifier":"tcelyb4ppoqk-outputs-0","html_id":"tcelyb4ppoqk-outputs-0","key":"tyuMVZ1477"}],"identifier":"tcelyb4ppoqk-outputs","html_id":"tcelyb4ppoqk-outputs","key":"gsvqH0d98j"}],"identifier":"tcelyb4ppoqk","label":"TcelYB4PPoQK","html_id":"tcelyb4ppoqk","key":"eMFbYdQSLC"}],"key":"KJG7hERWDS"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Stack & Queue","url":"/stack-queue","group":"Part 2. Linear Structures"}}},"domain":"http://localhost:3000"}