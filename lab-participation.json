e, department,attendance):\n    self.id = id\n    self.name = name\n    self.department = department\n    self.attendance = attendance\nperson1 = Attendance(123456,\"Ewha Kim\",\"AI\",my_attendance)\nprint(\"ID=\", person1.id, \", Name = \",person1.name, \", Department = \", person1.department,\", Attendance = \",person1.attendance)","identifier":"tze4bbjaqa5_-code","enumerator":"5","html_id":"tze4bbjaqa5-code","key":"G044rNiaji"},{"type":"outputs","id":"Lj3oMfcyzH98cg2gUa19X","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"ID= 123456 , Name =  Ewha Kim , Department =  AI , Attendance =  [{'date': '2025-03-10', 'status': 1}, {'date': '2025-03-15', 'status': 0}]\n"},"children":[],"identifier":"tze4bbjaqa5_-outputs-0","html_id":"tze4bbjaqa5-outputs-0","key":"TALFJPYWKD"}],"identifier":"tze4bbjaqa5_-outputs","html_id":"tze4bbjaqa5-outputs","key":"dUFo82AWs4"}],"identifier":"tze4bbjaqa5_","label":"tzE4bBjaqA5_","html_id":"tze4bbjaqa5","key":"uVDWsdIQSb"},{"type":"block","kind":"notebook-content","data":{"id":"dmx1JUn9qFA9"},"children":[{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":1,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Add a method ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gnCkaC0KxR"},{"type":"inlineCode","value":"mark_attendance(date, status)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cwDO6QrIV4"},{"type":"text","value":" that allows the recording of attendance for a particular date. The status should be either: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"S67l0O65wz"},{"type":"inlineCode","value":"1","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KrgFDlItKy"},{"type":"text","value":" for present and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AzSD3hgvIC"},{"type":"inlineCode","value":"0","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CO13adTijN"},{"type":"text","value":" for absent.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hkZahd4TPo"}],"key":"kugSDDDxp6"}],"key":"qre8wk7geB"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Add a method ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OEvNsy6NK4"},{"type":"inlineCode","value":"view_attendance()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vjUrecDhfK"},{"type":"text","value":" that prints out the attendance record for the student. The output should display each entry with the date and the attendance status (Present/Absent).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"De2dHCYUUf"}],"key":"KDaP14Q2ii"}],"key":"eNCLLbWzSf"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Add a method ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"SjJPkt2LmG"},{"type":"inlineCode","value":"update_attendance(date, status)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"n7Pcn8lrua"},{"type":"text","value":" that updates the attendance record for a specific date. If the given date is not found in the records, return a message indicating that the date is not found.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lT40W2prnl"}],"key":"Ev5QXjqqCu"}],"key":"XGVY4eG4XB"}],"key":"HIl1L9BRgq"}],"identifier":"dmx1jun9qfa9","label":"dmx1JUn9qFA9","html_id":"dmx1jun9qfa9","key":"ZYzj8QHUNu"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"OYNva6HnqH9f","outputId":"9fb68a8f-28da-4a6d-e714-a06fccb5bafb"},"children":[{"type":"code","lang":"python","executable":true,"value":"class Attendance:\n    def __init__(self, student_id, name, department, attendance=None):\n        self.student_id = student_id\n        self.name = name\n        self.department = department\n        self.attendance = attendance if attendance is not None else []\n\n    def mark_attendance(self, date, status):\n        self.attendance.append({\"date\": date, \"status\": status})\n\n    def view_attendance(self):\n        for record in self.attendance:\n            status_update = \"Present\" if record[\"status\"] == 1 else \"Absent\"\n            print(f\"Date: {record['date']}, Status: {status_update}\")\n\n    def update_attendance(self, date, status):\n        for record in self.attendance:\n            if record[\"date\"] == date:\n                record[\"status\"] = status\n                return \"Attendance updated successfully.\"\n        return \"Date is not found.\"\n\n\n# Example usage:\nperson1 = Attendance(123456, \"Ewha Kim\", \"AI\")\nperson1.mark_attendance(\"2025-03-10\", 1)\nperson1.mark_attendance(\"2025-03-11\", 0)\nperson1.mark_attendance(\"2025-03-15\", 1)\n\n# Update attendance for a specific date\nprint(person1.update_attendance(\"2025-03-10\", 0))\n\n# Viewing the attendance\nperson1.view_attendance()","identifier":"oynva6hnqh9f-code","enumerator":"6","html_id":"oynva6hnqh9f-code","key":"LMbbcic70W"},{"type":"outputs","id":"tls3gL4ZO3W4A-aWbN1eG","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Attendance updated successfully.\nDate: 2025-03-10, Status: Absent\nDate: 2025-03-11, Status: Absent\nDate: 2025-03-15, Status: Present\n"},"children":[],"identifier":"oynva6hnqh9f-outputs-0","html_id":"oynva6hnqh9f-outputs-0","key":"czuR0t9TEp"}],"identifier":"oynva6hnqh9f-outputs","html_id":"oynva6hnqh9f-outputs","key":"gOesODQaoA"}],"identifier":"oynva6hnqh9f","label":"OYNva6HnqH9f","html_id":"oynva6hnqh9f","key":"wemRW4vO1I"},{"type":"block","kind":"notebook-content","data":{"id":"xyX0RlbqAQqA"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Example (Algorithm)","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"EOPWmfF5Mx"}],"identifier":"example-algorithm","label":"Example (Algorithm)","html_id":"example-algorithm","implicit":true,"key":"qCh04rUxUl"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Create a function that output unique elements in a given array. Unique means distinct elements. What is the time complexity of the algorithm?","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"XUnRBzPQix"}],"key":"cbBzRYea9R"}],"identifier":"xyx0rlbqaqqa","label":"xyX0RlbqAQqA","html_id":"xyx0rlbqaqqa","key":"yhNLtsJgLe"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"SyOV9mcvqvBS","outputId":"a998c775-9cf1-4640-d833-cee53bbf616c"},"children":[{"type":"code","lang":"python","executable":true,"value":"# python program to print all distinct elements in a given array\n\ndef unique(arr):\n    result = list(set(arr))\n    print(result)\n\n\na = [1, 2, 2, 3, 4, 5, 5, 6, 7, 7]\nunique(a)","identifier":"syov9mcvqvbs-code","enumerator":"7","html_id":"syov9mcvqvbs-code","key":"f6G6wWHpGA"},{"type":"outputs","id":"Nw8tkh2y9-QbYhZQn53cO","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[1, 2, 3, 4, 5,