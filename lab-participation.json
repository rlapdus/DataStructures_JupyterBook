nd(i)\n    else:\n      odd_count.append(i)\n  even_count = len(even_count)\n  odd_count = len(odd_count)\n\n\n  print(\"Number of even/odd elements = \", even_count, \"/\", odd_count)\n\n\na = [1, 2, 2, 3, 4, 5, 5, 6, 7, 7]\nEvenOdd(a)","identifier":"jlu5jhhpqvbt-code","enumerator":"9","html_id":"jlu5jhhpqvbt-code","key":"MRaUv3cvq8"},{"type":"outputs","id":"XC2hIseZTXaBrR1n2GgB0","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Number of even/odd elements =  4 / 6\n"},"children":[],"identifier":"jlu5jhhpqvbt-outputs-0","html_id":"jlu5jhhpqvbt-outputs-0","key":"nK74pKwYXF"}],"identifier":"jlu5jhhpqvbt-outputs","html_id":"jlu5jhhpqvbt-outputs","key":"S5iYHofkvW"}],"identifier":"jlu5jhhpqvbt","label":"jlU5jhhPqvBT","html_id":"jlu5jhhpqvbt","key":"MgiGoORdln"}],"key":"byrvCVO2aX"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"My Data Structures Book","url":"/","group":"My Data Structures Book"},"next":{"title":"Stack & Queue","url":"/stack-queue","group":"Part 2. Linear Structures"}}},"domain":"http://localhost:3000"}