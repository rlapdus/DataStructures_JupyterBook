*\n\ndef isPalindrome(A):\n    stack = ListStack()\n    queue = ListQueue()\n\n    for ch in A:\n        stack.push(ch)\n        queue.enqueue(ch)\n\n    while not queue.isEmpty():\n        if stack.pop() != queue.dequeue():\n            return False\n\n    return True\n\nstr = 'civic'\nprint(str, \"is Palindrome?: \", isPalindrome(str))","identifier":"osvrjh_lditk-code","enumerator":"10","html_id":"osvrjh-lditk-code","key":"cV4PHceH3d"},{"type":"outputs","id":"UR8s6tXdQ-qk7u1oaBJ5r","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"civic is Palindrome?:  True\n"},"children":[],"identifier":"osvrjh_lditk-outputs-0","html_id":"osvrjh-lditk-outputs-0","key":"JxLewuDAnN"}],"identifier":"osvrjh_lditk-outputs","html_id":"osvrjh-lditk-outputs","key":"Ap9tEg2oR2"}],"identifier":"osvrjh_lditk","label":"OSVrjh_LDItk","html_id":"osvrjh-lditk","key":"NOSr8ap8ww"},{"type":"block","kind":"notebook-content","data":{"id":"FZgHxFapPz70"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Optional Fun Exercises","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UOwNl6wtbL"}],"identifier":"optional-fun-exercises","label":"Optional Fun Exercises","html_id":"optional-fun-exercises","implicit":true,"key":"ByHeaZqTOF"}],"identifier":"fzghxfappz70","label":"FZgHxFapPz70","html_id":"fzghxfappz70","key":"NNq5owVgj6"},{"type":"block","kind":"notebook-content","data":{"id":"F-HpVpjJJstO"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Stack: Webbrowser","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bcSWepkyJf"}],"identifier":"stack-webbrowser","label":"Stack: Webbrowser","html_id":"stack-webbrowser","implicit":true,"key":"cqD6XQPpdr"}],"identifier":"f-hpvpjjjsto","label":"F-HpVpjJJstO","html_id":"f-hpvpjjjsto","key":"XrbYlKoNEc"},{"type":"block","kind":"notebook-code","data":{"id":"UNXlokiiJtRn"},"children":[{"type":"code","lang":"python","executable":true,"value":"import webbrowser\nimport time\nimport sys\nstack = ListStack()\nurls = [ \"naver.com\", \"daum.net\", \"nate.com\"]\n# Browser history stacks up in the order in which you visit websites\n# push url of each visited websites to a stack\nfor url in urls:\n  stack.push(url)\n  # When you hit the back button, the previous URL is popped from the stack.\n\nwhile not stack.isEmpty(): # if stack is not empty\n  url = stack.pop() # pop the previous URL and open the browser\n  webbrowser.open('http://'+url)","identifier":"unxlokiijtrn-code","enumerator":"11","html_id":"unxlokiijtrn-code","key":"YX6472m4cb"},{"type":"outputs","id":"GIZrcmMg38Q_KBTySdlK1","children":[],"identifier":"unxlokiijtrn-outputs","html_id":"unxlokiijtrn-outputs","key":"xIXgFQKPZm"}],"identifier":"unxlokiijtrn","label":"UNXlokiiJtRn","html_id":"unxlokiijtrn","key":"twjInwnLz2"},{"type":"block","kind":"notebook-content","data":{"id":"2nGSQLLWP_uB"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Queue: Waiting List","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FBzX9bp6c7"}],"identifier":"queue-waiting-list","label":"Queue: Waiting List","html_id":"queue-waiting-list","implicit":true,"key":"ssP3ZU0lZA"}],"identifier":"2ngsqllwp_ub","label":"2nGSQLLWP_uB","html_id":"id-2ngsqllwp-ub","key":"wzVvJPg4u3"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"W6aL9lmxT0iL","outputId":"a4ccfcc5-2612-4039-8bf7-db8ea3c9a0dd"},"children":[{"type":"code","lang":"python","executable":true,"value":"select = input(\"Choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> \")\nqueue = ListQueue()\n\nwhile select != \"X\" and select != \"x\":\n    if select == \"I\" or select == \"i\":\n        data = input(\"Type Input Data ==> \")\n        queue.enqueue(data)\n        print(queue.size(), \"number of elements, front : \", queue.front(), \", rear : \", queue.queue[queue.size()-1])\n\n    elif select == \"D\" or select == \"d\":\n        print(\"Dequeue: removed an element from the front of the queue: \", queue.dequeue())\n        print(queue.size(), \"number of elements, front : \", queue.front(), \", rear : \", queue.queue[queue.size()-1])\n\n    else:\n        print(\"Wrong Insertion - should choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X)\")\n\n    select = input(\"Choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> \")\n\nprint(\"Terminate the program!\")","identifier":"w6al9lmxt0il-code","enumerator":"12","html_id":"w6al9lmxt0il-code","key":"YssKuOoHlX"},{"type":"outputs","id":"KeSdnvr13NFaY6vYA9U3h","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> apple\n1 number of elements, front :  apple , rear :  apple\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> watermelon\n2 number of elements, front :  apple , rear :  watermelon\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> grape\n3 number of elements, front :  apple , rear :  grape\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> d\nDequeue: removed an element from the front of the queue:  apple\n2 number of elements, front :  watermelon , rear :  grape\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> pineapple\n3 number of elements, front :  watermelon , rear :  pineapple\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> d\nDequeue: removed an element from the front of the queue:  watermelon\n2 number of elements, front :  grape 