:[{"type":"text","value":"Solution","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"UfA1f1mK5B"}],"identifier":"solution","label":"Solution","html_id":"solution-1","implicit":true,"key":"fm6Shyxw9V"}],"identifier":"hpmahpa-uze0","label":"hPmaHpA-uzE0","html_id":"hpmahpa-uze0","key":"Gqq5VMgT5f"},{"type":"block","kind":"notebook-code","data":{"id":"9ppWH1oJnAxE","colab":{"base_uri":"https://localhost:8080/"},"outputId":"35ea3bfb-8aa8-415e-bc31-f740b17a4624"},"children":[{"type":"code","lang":"python","executable":true,"value":"def fib_recursive2(n, memo):\n    # base case\n    if n <= 1:\n        return n\n\n    if memo[n] != -1:\n        return memo[n]\n\n\n    memo[n] = fib_recursive2(n - 1, memo) + fib_recursive2(n - 2, memo)\n\n    return memo[n]\n\n\n# run code\nn = 10\nmemo = [-1] * (n + 1)\n\nprint(\"fib:\", fib_recursive2(n, memo))","identifier":"9ppwh1ojnaxe-code","enumerator":"9","html_id":"id-9ppwh1ojnaxe-code","key":"Qt0ugVY4b8"},{"type":"outputs","id":"bLWZvFRbU0ZZQxPu4IX0c","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"fib: 55\n"},"children":[],"identifier":"9ppwh1ojnaxe-outputs-0","html_id":"id-9ppwh1ojnaxe-outputs-0","key":"EUyWbWcpmE"}],"identifier":"9ppwh1ojnaxe-outputs","html_id":"id-9ppwh1ojnaxe-outputs","key":"LhJRypMk4p"}],"identifier":"9ppwh1ojnaxe","label":"9ppWH1oJnAxE","html_id":"id-9ppwh1ojnaxe","key":"a93frsF7eK"},{"type":"block","kind":"notebook-content","data":{"id":"C5qVuJBksZDE"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Optional Exercise (Algorithm)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UTjsc2GyeK"}],"identifier":"optional-exercise-algorithm","label":"Optional Exercise (Algorithm)","html_id":"optional-exercise-algorithm","implicit":true,"key":"hnppnOrzpJ"},{"type":"paragraph","position":{"start":{"line":3,"column":1}