ints out the attendance record for the student. The output should display each entry with the date and the attendance status (Present/Absent).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"q6BUacxrEu"}],"key":"ZGyc2CKZ0T"}],"key":"JqSz1HsjkS"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Add a method ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"KjruyZ1MBV"},{"type":"inlineCode","value":"update_attendance(date, status)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"SVBRUwLaMK"},{"type":"text","value":" that updates the attendance record for a specific date. If the given date is not found in the records, return a message indicating that the date is not found.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jR0vesBN3Q"}],"key":"ChUtjmGe4D"}],"key":"G9iv2Rgl8X"}],"key":"MmwP2zI3EX"}],"identifier":"dmx1jun9qfa9","label":"dmx1JUn9qFA9","html_id":"dmx1jun9qfa9","key":"nic8fW5vxg"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"OYNva6HnqH9f","outputId":"9fb68a8f-28da-4a6d-e714-a06fccb5bafb"},"children":[{"type":"code","lang":"python","executable":true,"value":"class Attendance:\n    def __init__(self, student_id, name, department, attendance=None):\n        self.student_id = student_id\n        self.name = name\n        self.department = department\n        self.attendance = attendance if attendance is not None else []\n\n    def mark_attendance(self, date, status):\n        self.attendance.append({\"date\": date, \"status\": status})\n\n    def view_attendance(self):\n        for record in self.attendance:\n            status_update = \"Present\" if record[\"status\"] == 1 else \"Absent\"\n            print(f\"Date: {record['date']}, Status: {status_update}\")\n\n    def update_attendance(self, date, status):\n        for record in self.attendance:\n            if record[\"date\"] == date:\n                record[\"status\"] = status\n                return \"Attendance updated successfully.\"\n        return \"Date is not found.\"\n\n\n# Example usage:\nperson1 = Attendance(123456, \"Ewha Kim\", \"AI\")\nperson1.mark_attendance(\"2025-03-10\", 1)\nperson1.mark_attendance(\"2025-03-11\", 0)\nperson1.mark_attendance(\"2025-03-15\", 1)\n\n# Update attendance for a specific date\nprint(person1.update_attendance(\"2025-03-10\", 0))\n\n# Viewing the attendance\nperson1.view_attendance()","identifier":"oynva6hnqh9f-code","enumerator":"7","html_id":"oynva6hnqh9f-code","key":"OyWOk69Pu0"},{"type":"outputs","id":"N0PFWq0QSnWaOoYUyMLbY","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"Attendance updated successfully.\nDate: 2025-03-10, Status: Absent\nDate: 2025-03-11, Status: Absent\nDate: 2025-03-15, Status: Present\n"},"children":[],"identifier":"oynva6hnqh9f-outputs-0","html_id":"oynva6hnqh9f-outputs-0","key":"UK5jpRalkI"}],"identifier":"oynva6hnqh9f-outputs","html_id":"oynva6hnqh9f-outputs","key":"mGqcNlL8Jj"}],"identifier":"oynva6hnqh9f","label":"OYNva6HnqH9f","html_id":"oynva6hnqh9f","key":"puqXlbD9tt"},{"type":"block","kind":"notebook-content","data":{"id":"xyX0RlbqAQqA"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Example (Algorithm)","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"P5VXtfZHV4"}],"identifier":"example-algorithm","label":"Example (Algorithm)","html_id":"example-algorithm","implicit":true,"key":"yIEAnID0RI"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Create a function that output unique elem