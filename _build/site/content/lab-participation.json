append(i)\n  even_count = len(even_count)\n  odd_count = len(odd_count)\n\n\n  print(\"Number of even/odd elements = \", even_count, \"/\", odd_count)\n\n\na = [1, 2, 2, 3, 4, 5, 5, 6, 7, 7]\nEvenOdd(a)","identifier":"jlu5jhhpqvbt-code","enumerator":"9","html_id":"jlu5jhhpqvbt-code","key":"JOLW9pQLbK"},{"type":"outputs","id":"m0ZJWJo0xvN7YzflYVAO_","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Number of even/odd elements =  4 / 6\n"},"children":[],"identifier":"jlu5jhhpqvbt-outputs-0","html_id":"jlu5jhhpqvbt-outputs-0","key":"b499HuRMws"}],"identifier":"jlu5jhhpqvbt-outputs","html_id":"jlu5jhhpqvbt-outputs","key":"Ti5vAndh02"}],"identifier":"jlu5jhhpqvbt","label":"jlU5jhhPqvBT","html_id":"jlu5jhhpqvbt","key":"frTpfBdl3q"}],"key":"fzu6ykhEen"},"references":{"cite":{"order":[],"data":{}}}}