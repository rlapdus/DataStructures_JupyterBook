d\"); queue.enqueue(\"Thurs\"); queue.enqueue(\"Fri\")\nqueue.printQueue()\n\n# A function that reverses individual characters in a queue using recursive approach. Note that the original queue should be reversed.\n\ndef reverseQueue(queue):\n    if queue.isEmpty():\n        return\n    temp = queue.dequeue()\n    reverseQueue(queue)\n    queue.enqueue(temp)\n\nreverseQueue(queue)\nprint(\"After Reversing the queue:\")\nqueue.printQueue()","identifier":"aovj6kspony7-code","enumerator":"8","html_id":"aovj6kspony7-code","key":"tGfwXOsOor"},{"type":"outputs","id":"RRE7giNVn_SG5funOPDOH","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"Elements from front to end: \nMon Tue Wed Thurs Fri After Reversing the queue:\nElements from front to end: \nFri Thurs Wed Tue Mon "},"children":[],"identifier":"aovj6kspony7-outputs-0","html_id":"aovj6kspony7-outputs-0","key":"m4rbvatWsw"}],"identifier":"aovj6kspony7-outputs","html_id":"aovj6kspony7-outputs","key":"ELKpBpjkSy"}],"identifier":"aovj6kspony7","label":"aoVj6KSPONY7","html_id":"aovj6kspony7","key":"mpq9MrJtnC"},{"type":"block","kind":"notebook-code","data":{"id":"xfXffY0FPJ7q"},"children":[{"type":"code","lang":"python","executable":true,"value":"# add the below method to the ListQueue class.\ndef reverse(self):\n    if self.isEmpty():\n        return\n\n    temp = self.dequeue()\n    self.reverse()\n    self.enqueue(temp)","identifier":"xfxffy0fpj7q-code","enumerator":"9","html_id":"xfxffy0fpj7q-code","key":"pqAYcyXZOd"},{"type":"outputs","id":"7EvNPLfknov559K2bcERj","children":[],"identifier":"xfxffy0fpj7q-outputs","html_id":"xfxffy0fpj7q-outputs","key":"d4RnYMsgBM"}],"identifier":"xfxffy0fpj7q","label":"xfXffY0FPJ7q","html_id":"xfxffy0fpj7q","key":"WYuybl61sL"},{"type":"block","kind":"notebook-content","data":{"id":"u2DlphfyDJTw"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Palindrome","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pCUEWiFjIL"}],"identifier":"palindrome","label":"Palindrome","html_id":"palindrome","implicit":true,"key":"m3n8yOCgRC"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Palindrome is word, phrase, or sequence that reads the same backward as forward (e.g. madam, mom, kayak). Write a function that checks if a string is palindrome using stack and queue data structure.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cFsEeTUzDZ"}],"key":"OvEk17eyRa"}],"key":"G3jjlykpi6"}],"key":"MxXTBgQV2B"}],"identifier":"u2dlphfydjtw","label":"u2DlphfyDJTw","html_id":"u2dlphfydjtw","key":"E5WyzokZFs"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"OSVrjh_LDItk","outputId":"303c2a44-6fa5-4a03-8301-374eea041879"},"children":[{"type":"code","lang":"python","executable":true,"value":"from DataStructureCode.ListStack import *\nfrom DataStructureCode.ListQueue import *\n\ndef isPalindrome(A):\n    stack = ListStack()\n    queue = ListQueue()\n\n    for ch in A:\n        stack.push(ch)\n        queue.enqueue(ch)\n\n    while not queue.isEmpty():\n        if stack.pop() != queue.dequeue():\n            return False\n\n    return True\n\nstr = 'civic'\nprint(str, \"is Palindrome?: \", isPalindrome(str))","identifier":"osvrjh_lditk-code","enumerator":"10","html_id":"osvrjh-lditk-code","key":"y62sWoRUTZ"},{"type":"outputs","id":"vTX5TVPRLfZLat8sgi1M2","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"civic is Palindrome?:  True\n"},"children":[],"identifier":"osvrjh_lditk-outputs-0","html_id":"osvrjh-lditk-outputs-0","key":"LzM8Sx3rcD"}],"identifier":"osvrjh_lditk-outputs","html_id":"osvrjh-lditk-outputs","key":"yxQ1ldyK8B"}],"identifier":"osvrjh_lditk","label":"OSVrjh_LDItk","html_id":"osvrjh-lditk","key":"kZNdziChAZ"},{"type":"block","kind":"notebook-content","data":{"id":"FZgHxFapPz70"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Optional Fun Exercises","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kewVxQFTer"}],"identifier":"optional-fun-exercises","label":"Optional Fun Exercises","html_id":"optional-fun-exercises","implicit":true,"key":"cKVmgrJzEO"}],"identifier":"fzghxfappz70","label":"FZgHxFapPz70","html_id":"fzghxfappz70","key":"McIXdNXK5i"},{"type":"block","kind":"notebook-content","data":{"id":"F-HpVpjJJstO"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Stack: Webbrowser","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yXHit4UPGj"}],"identifier":"stack-webbrowser","label":"Stack: Webbrowser","html_id":"stack-webbrowser","implicit":true,"key":"x2eVcNAQYe"}],"identifier":"f-hpvpjjjsto","label":"F-HpVpjJJstO","html_id":"f-hpvpjjjsto","key":"KaEBhfArgI"},{"type":"block","kind":"notebook-code","data":{"id":"UNXlokiiJtRn"},"children":[{"type":"code","lang":"python","executable":true,"value":"import webbrowser\nimport time\nimport sys\nstack = ListStack()\nurls = [ \"naver.com\", \"daum.net\", \"nate.com\"]\n# Browser history stacks up in the order in which you visit websites\n# push url of each visited websites to a stack\nfor url in urls:\n  stack.push(url)\n  # When you hit the back button, the previous URL is popped from the stack.\n\nwhile not stack.isEmpty(): # if stack is not empty\n  url = stack.pop() # pop the previous URL and open the browser\n  webbrowser.open('http://'+url)","identifier":"unxlokiijtrn-code","enumerator":"11","