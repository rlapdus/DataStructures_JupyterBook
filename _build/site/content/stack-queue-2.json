Elements from top to bottom: \n400 300 200 100 \nReversed Stack: \nOriginal Stack: After Reversing\nElements from top to bottom: \n100 200 300 400 \n"},"children":[],"identifier":"tszoagpdpazi-outputs-0","html_id":"tszoagpdpazi-outputs-0","key":"uqG4ZI5JEI"}],"identifier":"tszoagpdpazi-outputs","html_id":"tszoagpdpazi-outputs","key":"UaafLdZVsE"}],"identifier":"tszoagpdpazi","label":"tSZOAgpDPazI","html_id":"tszoagpdpazi","key":"LyVOzIRllB"},{"type":"block","kind":"notebook-code","data":{"id":"wk_udMS-SGeH","colab":{"base_uri":"https://localhost:8080/"},"outputId":"fd98198e-0786-42be-feee-336c4e82cdc3"},"children":[{"type":"code","lang":"python","executable":true,"value":"# add the below method to the ListStack class\nclass ListStack:\n    def __init__(self):\n        self.stack = []\n\n    def push(self, x):\n        self.stack.append(x)\n\n    def pop(self):\n        return self.stack.pop()\n\n    def isEmpty(self):\n        return len(self.stack) == 0\n\n    def printStack(self):\n        print(self.stack)\n\n    def reverse(self):\n        temp = []\n\n\n        while not self.isEmpty():\n            temp.append(self.pop())\n\n\n        for item in temp:\n            self.push(item)\n\nstack=ListStack()\nstack.push(100); stack.push(200); stack.push(300); stack.push(400)\nstack.reverse()\nstack.printStack()","identifier":"wk_udms-sgeh-code","enumerator":"7","html_id":"wk-udms-sgeh-code","key":"GPBoPddKlp"},{"type":"outputs","id":"n-iGBAQMkiG7wQfOTL-lw","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"[400, 300, 200, 100]\n"},"children":[],"identifier":"wk_udms-sgeh-outputs-0","html_id":"wk-udms-sgeh-outputs-0","key":"w2WqDBOKGf"}],"identifier":"wk_udms-sgeh-outputs","html_id":"wk-udms-sgeh-outputs","key":"mQmYsvFtHA"}],"identifier":"wk_udms-sgeh","label":"wk_udMS-SGeH","html_id":"wk-udms-sgeh","key":"qPcWfvVa4z"},{"type":"block","kind":"notebook-content","data":{"id":"Vc-KbpKGONY6"},"children":[{"type":"heading","depth":