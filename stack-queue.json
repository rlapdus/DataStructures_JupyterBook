(stack):\n    temp = []  # 임시 리스트\n\n    # 다 꺼내서 temp에 저장\n    while not stack.isEmpty():\n        temp.append(stack.pop())\n\n    # 다시 넣기\n    for item in temp:\n        stack.push(item)\n\nstack = ListStack()\nstack.push(100); stack.push(200); stack.push(300); stack.push(400)\nprint(\"Original Stack: Before Reversing\")\nstack.printStack()\n\nprint(\"Reversed Stack: \")\nreverse(stack)\n\nprint(\"Original Stack: After Reversing\")\nstack.printStack()","identifier":"tszoagpdpazi-code","enumerator":"6","html_id":"tszoagpdpazi-code","key":"jNypQ5dvhp"},{"type":"outputs","id":"3vhHxNLw9vFSSLXlWrFN0","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Original Stack: Before Reversing\nElements from top to bottom: \n400 300 200 100 \nReversed Stack: \nOriginal Stack: After Reversing\nElements from top to bottom: \n100 200 300 400 \n"},"children":[],"identifier":"tszoagpdpazi-outputs-0","html_id":"tszoagpdpazi-outputs-0","key":"i72BZQllaG"}],"identifier":"tszoagpdpazi-outputs","html_id":"tszoagpdpazi-outputs","key":"x3GdVRuLE7"}],"identifier":"tszoagpdpazi","label":"tSZOAgpDPazI","html_id":"tszoagpdpazi","key":"Hf3P7SVe04"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"wk_udMS-SGeH","outputId":"fd98198e-0786-42be-feee-336c4e82cdc3"},"children":[{"type":"code","lang":"python","executable":true,"value":"# add the below method to the ListStack class\nclass ListStack:\n    def __init__(self):\n        self.stack = []\n\n    def push(self, x):\n        self.stack.append(x)\n\n    def pop(self):\n        return self.stack.pop()\n\n    def isEmpty(self):\n        return len(self.stack) == 0\n\n    def printStack(self):\n        print(self.stack)\n\n    def reverse(self):\n        temp = []\n\n\n        while not self.isEmpty():\n            temp.append(self.pop())\n\n\n        for item in temp:\n            self.push(item)\n\nstack=ListStack()\nstack.push(100); stack.push(200); stack.push(300); stack.push(400)\nstack.reverse()\nstack.printStack()","identifier":"wk_udms-sgeh-code","enumerator":"7","html_id":"wk-udms-sgeh-code","key":"v47XHYwXLG"},{"type":"outputs","id":"o2liFYccDhDinxh1DYYDL","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[400, 300, 200, 100]\n"},"children":[],"identifier":"wk_udms-sgeh-outputs-0","html_id":"wk-udms-sgeh-outputs-0","key":"pD8t3symxS"}],"identifier":"wk_udms-sgeh-outputs","html_id":"wk-udms-sgeh-outputs","key":"t0myXYEASW"}],"identifier":"wk_udms-sgeh","label":"wk_udMS-SGeH","html_id":"wk-udms-sgeh","key":"cElhrintag"},{"type":"block","kind":"notebook-content","data":{"id":"Vc-KbpKGONY6"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reverse: Queue","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gyxwgTV3xD"}],"identifier":"reverse-queue","label":"Reverse: Queue","html_id":"reverse-queue","implicit":true,"key":"eBkSEVn0LG"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a function that reverses individual characters in a queue using recursive approach. Note that the original queue should be reversed.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SGPVkSLK5g"}],"key":"UQNt94SEuh"}],"key":"zA6I6AGK5R"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Try to add ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"JWfR2cVzBJ"},{"type":"inlineCode","value":"reverse()","position":{"start":{"line":4,"colu