e":true,"value":"def reverse(stack):\n    temp = []  # 임시 리스트\n\n    # 다 꺼내서 temp에 저장\n    while not stack.isEmpty():\n        temp.append(stack.pop())\n\n    # 다시 넣기\n    for item in temp:\n        stack.push(item)\n\nstack = ListStack()\nstack.push(100); stack.push(200); stack.push(300); stack.push(400)\nprint(\"Original Stack: Before Reversing\")\nstack.printStack()\n\nprint(\"Reversed Stack: \")\nreverse(stack)\n\nprint(\"Original Stack: After Reversing\")\nstack.printStack()","identifier":"tszoagpdpazi-code","enumerator":"6","html_id":"tszoagpdpazi-code","key":"N4yvd7pD6C"},{"type":"outputs","id":"yMyS1RdMGWUimcdEzJgPH","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Original Stack: Before Reversing\nElements from top to bottom: \n400 300 200 100 \nReversed Stack: \nOriginal Stack: After Reversing\nElements from top to bottom: \n100 200 300 400 \n"},"children":[],"identifier":"tszoagpdpazi-outputs-0","html_id":"tszoagpdpazi-outputs-0","key":"YuK0Du3OBx"}],"identifier":"tszoagpdpazi-outputs","html_id":"tszoagpdpazi-outputs","key":"jDB6yUB5Zh"}],"identifier":"tszoagpdpazi","label":"tSZOAgpDPazI","html_id":"tszoagpdpazi","key":"pYa1hrPtI7"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"wk_udMS-SGeH","outputId":"fd98198e-0786-42be-feee-336c4e82cdc3"},"children":[{"type":"code","lang":"python","executable":true,"value":"# add the below method to the ListStack class\nclass ListStack:\n    def __init__(self):\n        self.stack = []\n\n    def push(self, x):\n        self.stack.append(x)\n\n    def pop(self):\n        return self.stack.pop()\n\n    def isEmpty(self):\n        return len(self.stack) == 0\n\n    def printStack(self):\n        print(self.stack)\n\n    def reverse(self):\n        temp = []\n\n\n        while not self.isEmpty():\n            temp.append(self.pop())\n\n\n        for item in temp:\n            self.push(item)\n\nstack=ListStack()\nstack.push(10