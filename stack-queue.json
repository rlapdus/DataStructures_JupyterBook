ataStructureCode.ListQueue import *\n\ndef isPalindrome(A):\n    stack = ListStack()\n    queue = ListQueue()\n\n    for ch in A:\n        stack.push(ch)\n        queue.enqueue(ch)\n\n    while not queue.isEmpty():\n        if stack.pop() != queue.dequeue():\n            return False\n\n    return True\n\nstr = 'civic'\nprint(str, \"is Palindrome?: \", isPalindrome(str))","identifier":"osvrjh_lditk-code","enumerator":"10","html_id":"osvrjh-lditk-code","key":"ZdfY3y9jYw"},{"type":"outputs","id":"gxFQv5rCbRAWEGse5cx6i","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"civic is Palindrome?:  True\n"},"children":[],"identifier":"osvrjh_lditk-outputs-0","html_id":"osvrjh-lditk-outputs-0","key":"TmpwIjVYEl"}],"identifier":"osvrjh_lditk-outputs","html_id":"osvrjh-lditk-outputs","key":"pRE7L1xMSk"}],"identifier":"osvrjh_lditk","label":"OSVrjh_LDItk","html_id":"osvrjh-lditk","key":"He8DnEsIsd"},{"type":"block","kind":"notebook-content","data":{"id":"FZgHxFapPz70"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Optional Fun Exercises","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KgzaOKv8Ye"}],"identifier":"optional-fun-exercises","label":"Optional Fun Exercises","html_id":"optional-fun-exercises","implicit":true,"key":"lvTgyFJCbR"}],"identifier":"fzghxfappz70","label":"FZgHxFapPz70","html_id":"fzghxfappz70","key":"iviE2eBTJj"},{"type":"block","kind":"notebook-content","data":{"id":"F-HpVpjJJstO"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Stack: Webbrowser","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rsTMgE0Xzl"}],"identifier":"stack-webbrowser","label":"Stack: Webbrowser","html_id":"stack-webbrowser","implicit":true,"key":"c6j3d3Wx13"}],"identifier":"f-hpvpjjjsto","label":"F-HpVpjJJstO","html_id":"f-hpvpjjjsto","key":"DXNt8sVdIx"},{"type":"block","kind":"notebook-code","data":{"id":"UNXlokiiJtRn"},"children":[{"type":"code","lang":"python","executable":true,"value":"import webbrowser\nimport time\nimport sys\nstack = ListStack()\nurls = [ \"naver.com\", \"daum.net\", \"nate.com\"]\n# Browser history stacks up in the order in which you visit websites\n# push url of each visited websites to a stack\nfor url in urls:\n  stack.push(url)\n  # When you hit the back button, the previous URL is popped from the stack.\n\nwhile not stack.isEmpty(): # if stack is not empty\n  url = stack.pop() # pop the previous URL and open the browser\n  webbrowser.open('http://'+url)","identifier":"unxlokiijtrn-code","enumerator":"11","html_id":"unxlokiijtrn-code","key":"Vo6EZBV9Iy"},{"type":"outputs","id":"yIgqF2qUEA_3pY7f8Irwy","children":[],"identifier":"unxlokiijtrn-outputs","html_id":"unxlokiijtrn-outputs","key":"gYQBer2Pww"}],"identifier":"unxlokiijtrn","label":"UNXlokiiJtRn","html_id":"unxlokiijtrn","key":"YZnzLa9Kjc"},{"type":"block","kind":"notebook-content","data":{"id":"2nGSQLLWP_uB"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Queue: Waiting List","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"r57KruLiwQ"}],"identifier":"queue-waiting-list","label":"Queue: Waiting List","html_id":"queue-waiting-list","implicit":true,"key":"CU8ug0hSMr"}],"identifier":"2ngsqllwp_ub","label":"2nGSQLLWP_uB","html_id":"id-2ngsqllwp-ub","key":"taLOxYi2Fy"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"W6aL9lmxT0iL","outputId":"a4ccfcc5-2612-4039-8bf7-db8ea3c9a0dd"},"children":[{"type":"code","lang":"python","executable":true,"value":"select = input(\"Choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> \")\nqueue = ListQueue()\n\nwhile select != \"X\" and select != \"x\":\n    if select == \"I\" or select == \"i\":\n        data = input(\"Type Input Data ==> \")\n        queue.enqueue(data)\n        print(queue.size(), \"number of elements, front : \", queue.front(), \", rear : \", queue.queue[queue.size()-1])\n\n    elif select == \"D\" or select == \"d\":\n        print(\"Dequeue: removed an element from the front of the queue: \", queue.dequeue())\n        print(queue.size(), \"number of elements, front : \", queue.front(), \", rear : \", queue.queue[queue.size()-1])\n\n    else:\n        print(\"Wrong Insertion - should choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X)\")\n\n    select = input(\"Choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> \")\n\nprint(\"Terminate the program!\")","identifier":"w6al9lmxt0il-code","enumerator":"12","html_id":"w6al9lmxt0il-code","key":"OI8jC4YTgn"},{"type":"outputs","id":"7jrZMxNYW45-cVZLtZZA4","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> apple\n1 number of elements, front :  apple , rear :  apple\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> watermelon\n2 number of elements, front :  apple , rear :  watermelon\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> grape\n3 number of elements, front :  apple , rear :  grape\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> d\nDequeue: removed an element from the front of the queue:  apple\n2 number of elements, front :  watermelon , rear :  grape\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> pineapple\n3 number of elements, front :  watermelon , rear :  pineapple\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> d\nDequeue: removed an element from the front of the queue:  watermelon\n2 number of elements, front :  grape , rear :  pineapple\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> x\nTerminate the program!\n"},"children":[],"identifier":"w6al9lmxt0il-outputs-0","html_id":"w6al9lmxt0il-outputs-0","key":"fifCvagNhj"}],"identifier":"w6al9lmxt0il-outputs","html_id":"w6al9lmxt0il-outputs","key":"XrFeNu0kos"}],"identifier":"w6al9lmxt0il","label":"W6aL9lmxT0iL","html_id":"w6al9lmxt0il","key":"v23ZVxOisQ"}],"key":"HBC4dlZf5R"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Python Fundamentals","url":"/lab-participation","group":"Part 1. Basic Python"},"next":{"title":"Tree","url":"/tree","group":"Part 3. Nonlinear Structures"}}},"domain":"http://localhost:3000"}