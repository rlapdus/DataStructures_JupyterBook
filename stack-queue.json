od to the ListQueue class.\ndef reverse(self):\n    if self.isEmpty():\n        return\n\n    temp = self.dequeue()\n    self.reverse()\n    self.enqueue(temp)","identifier":"xfxffy0fpj7q-code","enumerator":"9","html_id":"xfxffy0fpj7q-code","key":"dghXctlvz0"},{"type":"outputs","id":"U8atwTCk5VAjXq5N36QNE","children":[],"identifier":"xfxffy0fpj7q-outputs","html_id":"xfxffy0fpj7q-outputs","key":"T73sD0r3Il"}],"identifier":"xfxffy0fpj7q","label":"xfXffY0FPJ7q","html_id":"xfxffy0fpj7q","key":"soxYG8teQh"},{"type":"block","kind":"notebook-content","data":{"id":"u2DlphfyDJTw"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Palindrome","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gX3OB028Lp"}],"identifier":"palindrome","label":"Palindrome","html_id":"palindrome","implicit":true,"key":"g09HpWXngj"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Palindrome is word, phrase, or sequence that reads the same backward as forward (e.g. madam, mom, kayak). Write a function that checks if a string is palindrome using stack and queue data structure.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BayN7e5zQ4"}],"key":"fQ9gsfw45B"}],"key":"hQoGl8igWs"}],"key":"iNcCC7IbSS"}],"identifier":"u2dlphfydjtw","label":"u2DlphfyDJTw","html_id":"u2dlphfydjtw","key":"Q0x4z96sdV"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"OSVrjh_LDItk","outputId":"303c2a44-6fa5-4a03-8301-374eea041879"},"children":[{"type":"code","lang":"python","executable":true,"value":"from DataStructureCode.ListStack import *\nfrom DataStructureCode.ListQueue import *\n\ndef isPalindrome(A):\n    stack = ListStack()\n    queue = ListQueue()\n\n    for ch in A:\n        stack.push(ch)\n        queue.enqueue(ch)\n\n    while not queue.isEmpty():\n        if stack.pop() != queue.dequeue():\n            return False\n\n    return True\n\nstr = 'civic'\nprint(str, \"is Palindrome?: \", isPalindrome(str))","identifier":"osvrjh_lditk-code","enumerator":"10","html_id":"osvrjh-lditk-code","key":"Kj4maOmKOO"},{"type":"outputs","id":"WH06k9JQxLMN_Tc6ip7Zw","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"civic is Palindrome?:  True\n"},"children":[],"identifier":"osvrjh_lditk-outputs-0","html_id":"osvrjh-lditk-outputs-0","key":"c4Ns6HzjMT"}],"identifier":"osvrjh_lditk-outputs","html_id":"osvrjh-lditk-outputs","key":"ngD9S4UTOM"}],"identifier":"osvrjh_lditk","label":"OSVrjh_LDItk","html_id":"osvrjh-lditk","key":"grZ2szS8BY"},{"type":"block","kind":"notebook-content","data":{"id":"FZgHxFapPz70"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Optional Fun Exercises","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HiRgmIVqV0"}],"identifier":"optional-fun-exercises","label":"Optional Fun Exercises","html_id":"optional-fun-exercises","implicit":true,"key":"hiRPDS5LXk"}],"identifier":"fzghxfappz70","label":"FZgHxFapPz70","html_id":"fzghxfappz70","key":"BI3PRGMC6s"},{"type":"block","kind":"notebook-content","data":{"id":"F-HpVpjJJstO"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Stack: Webbrowser","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AD8pLoqVNX"}],"identifier":"stack-webbrowser","label":"Stack: Webbrowser","html_id":"stack-webbrowser","implicit":true,"key":"xyH18j1vsO"}],"identifier":"f-hpvpjjjsto","label":"F-HpVpjJJstO","html_id":"f-hpvpjjjsto","key":"P4bctbqPmg"},{"type":"block","kind":"notebook-code","data":{"id":"UNXlokiiJtRn"},"children":[{"type":"code","lang":"python","executable":true,"value":"import webbrowser\nimport time\nimport sys\nstack = ListStack()\nurls = [ \"naver.com\", \"daum.net\", \"nate.com\"]\n# Browser history stacks up in the order in which you visit websites\n# push url of each visited websites to a stack\nfor url in urls:\n  stack.push(url)\n  # When you hit the back button, the previous URL is popped from the stack.\n\nwhile not stack.isEmpty(): # if stack is not empty\n  url = stack.pop() # pop the previous URL and open the browser\n  webbrowser.open('http://'+url)","identifier":"unxlokiijtrn-code","enumerator":"11","html_id":"unxlokiijtrn-code","key":"lBKK5Ckmi2"},{"type":"outputs","id":"tVvFGRY6GnJH5Yf9McB3z","children":[],"identifier":"unxlokiijtrn-outputs","html_id":"unxlokiijtrn-outputs","key":"jsRy29fV0s"}],"identifier":"unxlokiijtrn","label":"UNXlokiiJtRn","html_id":"unxlokiijtrn","key":"X732nzo4sJ"},{"type":"block","kind":"notebook-content","data":{"id":"2nGSQLLWP_uB"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Queue: Waiting List","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"St3vrVU4Vm"}],"identifier":"queue-waiting-list","label":"Queue: Waiting List","html_id":"queue-waiting-list","implicit":true,"key":"XUAH1wyPsZ"}],"identifier":"2ngsqllwp_ub","label":"2nGSQLLWP_uB","html_id":"id-2ngsqllwp-ub","key":"MJv2JfxoxO"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"W6aL9lmxT0iL","outputId":"a4ccfcc5-2612-4039-8bf7-db8ea3c9a0dd"},"children":[{"type":"code","lang":"python","executable":true,"value":"select = input(\"Choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> \")\nqueue = ListQueue()\n\nwhile select != \"X\" and select != \"x\":\n    if select == \"I\" or select == \"i\":\n        data = input(\"Type Input Data ==> \")\n        queue.enqueue(data)\n        print(queue.size(), \"number of elements, front : \", queue.front(), \", rear : \", queue.queue[queue.size()-1])\n\n    elif select == \"D\" or select == \"d\":\n        print(\"Dequeue: removed an element from the front of the queue: \", queue.dequeue())\n        print(queue.size(), \"number of elements, front : \", queue.front(), \", rear : \", queue.queue[queue.size()-1])\n\n    else:\n        print(\"Wrong Insertion - should choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X)\")\n\n    select = input(\"Choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> \")\n\nprint(\"Terminate the program!\")","identifier":"w6al9lmxt0il-code","enumerator":"12","html_id":"w6al9lmxt0il-code","key":"GSehkpo3Zy"},{"type":"outputs","id":"5J6Kvkp6ppbdM1VgvkaQq","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Choose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> apple\n1 number of elements, front :  apple , rear :  apple\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> watermelon\n2 number of elements, front :  apple , rear :  watermelon\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> grape\n3 number of elements, front :  apple , rear :  grape\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> d\nDequeue: removed an element from the front of the queue:  apple\n2 number of elements, front :  watermelon , rear :  grape\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> i\nType Input Data ==> pineapple\n3 number of elements, front :  watermelon , rear :  pineapple\nChoose one of the followings (I/D/X): Insert(I)/Delete(D)/Exit(X) ==> d\nDequeue: removed an element from the front of the queue:  watermelon\n2 number of elements, front :  